AuthType Basic
AuthName "Preview"
AuthBasicProvider file
AuthUserFile /web/waldkaetzchencolor.waldkaetzchen.de/.htpasswd
Require valid-user

# ---------------------------------------------------------------------------
# Kompression
# HTML, CSS und JS gingen bisher unkomprimiert raus. support.js und
# react-dom sind zusammen rund 200 KB und schrumpfen mit gzip auf etwa ein
# Drittel. WebP und woff2 sind schon komprimiert und bleiben aussen vor.
# Alle Bloecke sind in IfModule gekapselt: fehlt ein Modul, wird der Block
# ignoriert statt einen 500er zu werfen.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
  </IfModule>
</IfModule>

# Falls Brotli verfuegbar ist, hat es Vorrang.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# MIME-Typen
# Aeltere Apache-Installationen liefern .webp und .woff2 ohne passenden
# Content-Type aus, was Caching und Font-Ladung stoert.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType font/woff2                  .woff2
  AddType text/javascript             .js
  AddType text/css                    .css
</IfModule>

# ---------------------------------------------------------------------------
# Browser-Cache
# Bilder, Fonts und die React-Bundles sind versionsstabil und duerfen lange
# liegen bleiben. Die .dc.html-Seiten dagegen muessen bei jedem Deploy sofort
# neu geladen werden, sonst sieht der Kunde alte Inhalte.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType text/javascript       "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # React liegt versioniert unter vendor/ und aendert sich nur mit einem
  # bewussten Upgrade - darf also unveraenderlich gecacht werden.
  <FilesMatch "^(react|react-dom)\.production\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # Seiten immer frisch validieren.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Default: nie cachen, auch nicht die nackte Domain ("/") oder eine
  # Fehlerantwort wie 401/403. Ohne das griff obige Regel nur bei .html-
  # Endung - "/" hat keine Endung und lief darum ohne jede Cache-Anweisung
  # raus. Chrome preloadet die oberste Adressleisten-Vorschau im
  # Hintergrund, bevor Enter gedrueckt wird; ein Basic-Auth-Dialog kann bei
  # so einem unsichtbaren Preload nicht erscheinen, die 401-Antwort kam
  # bislang ungeschuetzt zurueck und konnte als "Ergebnis" haengen bleiben.
  # "always" wirkt auch auf Fehlerantworten, die Bedingung schliesst nur
  # die Dateitypen aus, die oben bewusst lange gecacht werden.
  Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} !~ m#\.(webp|png|jpe?g|woff2|js|css)$#"
</IfModule>

# ---------------------------------------------------------------------------
# Die Quelldateien unter uploads/ (Blueprints, Original-PNGs, private Fotos)
# gehoeren nicht ins Web. Der Deploy laedt sie mit hoch, deshalb hier sperren.
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "\.(psd|ai|sketch)$">
    Require all denied
  </FilesMatch>
</IfModule>
RedirectMatch 404 ^/uploads/blueprints/
