AuthType Basic
AuthName "Preview"
AuthBasicProvider file
AuthUserFile /web/waldkaetzchencolor.waldkaetzchen.de/.htpasswd
Require valid-user

# ---------------------------------------------------------------------------
# Kompression
# HTML, CSS und JS gingen bisher unkomprimiert raus. support.js und
# react-dom sind zusammen rund 200 KB und schrumpfen mit gzip auf etwa ein
# Drittel. WebP und woff2 sind schon komprimiert und bleiben aussen vor.
# Alle Bloecke sind in IfModule gekapselt: fehlt ein Modul, wird der Block
# ignoriert statt einen 500er zu werfen.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
  </IfModule>
</IfModule>

# Falls Brotli verfuegbar ist, hat es Vorrang.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# MIME-Typen
# Aeltere Apache-Installationen liefern .webp und .woff2 ohne passenden
# Content-Type aus, was Caching und Font-Ladung stoert.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType font/woff2                  .woff2
  AddType text/javascript             .js
  AddType text/css                    .css
</IfModule>

# ---------------------------------------------------------------------------
# Browser-Cache
# Bilder, Fonts und die React-Bundles sind versionsstabil und duerfen lange
# liegen bleiben. Die .dc.html-Seiten dagegen muessen bei jedem Deploy sofort
# neu geladen werden, sonst sieht der Kunde alte Inhalte.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType text/javascript       "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  # Kein ExpiresByType fuer text/html: das wuerde einen eigenen
  # Cache-Control-Header setzen, den "Header always set" weiter unten nicht
  # zuverlaessig ersetzt (siehe Kommentar dort) - Ergebnis waeren zwei
  # Cache-Control-Header in derselben Antwort. Die Zeile ist ohnehin
  # ueberfluessig: die "no-store"-Regel deckt Seiten bereits ab, und zwar
  # staerker als "access plus 0 seconds" es je koennte.
</IfModule>

<IfModule mod_setenvif.c>
  # Markiert Anfragen auf Dateitypen, die absichtlich lange im Browser
  # liegen bleiben duerfen. env= ist auf praktisch jeder Apache-Installation
  # verfuegbar, anders als die expr=-Bedingung von mod_headers, die erst ab
  # einer neueren Version existiert und auf manchen Hosts einen 500
  # (unbekannte Direktive in der .htaccess) ausloesen kann.
  SetEnvIf Request_URI "\.(webp|png|jpe?g|woff2|js|css)$" WK_LONG_CACHE
</IfModule>

<IfModule mod_headers.c>
  # React liegt versioniert unter vendor/ und aendert sich nur mit einem
  # bewussten Upgrade - darf also unveraenderlich gecacht werden.
  <FilesMatch "^(react|react-dom)\.production\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Alles andere darf nie zwischengespeichert werden: Seiten, die nackte
  # Domain ("/") und Fehlerantworten wie 401/403. "always" ist hier noetig,
  # weil normales "Header set" auf Fehlerantworten (4xx/5xx) nicht wirkt -
  # genau die faellt aber ins Gewicht, siehe unten. "always set" scheint auf
  # dieser Apache-Version keine schon vorhandene Cache-Control-Kopfzeile
  # aus mod_expires zu ersetzen, sondern legt eine zweite an - deshalb darf
  # kein ExpiresByType fuer text/html mehr existieren (siehe oben).
  # Grund fuer die Regel: Chrome preloadet die oberste Adressleisten-
  # Vorschau im Hintergrund, bevor Enter gedrueckt wird; ein Basic-Auth-
  # Dialog kann bei so einem unsichtbaren Preload nicht erscheinen, und eine
  # ungeschuetzte 401-Antwort auf "/" konnte als "Ergebnis" haengen bleiben.
  Header always set Cache-Control "no-store" env=!WK_LONG_CACHE
</IfModule>

# ---------------------------------------------------------------------------
# Die Quelldateien unter uploads/ (Blueprints, Original-PNGs, private Fotos)
# gehoeren nicht ins Web. Der Deploy laedt sie mit hoch, deshalb hier sperren.
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "\.(psd|ai|sketch)$">
    Require all denied
  </FilesMatch>
</IfModule>
RedirectMatch 404 ^/uploads/blueprints/
